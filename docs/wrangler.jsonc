// Cloudflare's Git integration (Workers Builds) deploys the built site from main as
// a Worker that serves only static files. See docs/README.md.
{
	"name": "cyclix-docs",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "docs.cyclix.dev", "custom_domain": true }],
	// The custom domain is the site's only address: no workers.dev address, and no
	// public link for each deployed version.
	"workers_dev": false,
	"preview_urls": false
}
