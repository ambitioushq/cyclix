#!/usr/bin/env python3
"""A fake coding agent that follows a script instead of thinking.

It reads the prompt from stdin and saves it as prompts/<n>.txt in $CYCLIX_FAKES_DIR,
where n counts the calls. Then it follows entry n of agent-script.json: sleeps if
asked, writes the files, commits them if asked, and prints the same lines as
`claude -p --output-format stream-json --verbose`: an init line, one assistant line
per turn before it sleeps, and the result line at the end, or at once on SIGINT.
A step with `stdout` prints that text instead.
Every process it starts is recorded in agent-pids.txt, and each call's arguments
and environment in agent-calls.jsonl, with values only for the names the engine sets.
"""

import json
import os
import signal
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from world import World


def recorded_env():
    """Every name in the environment, with a value only for the ones the engine sets.

    The rest can hold a real login from the developer's own environment, which has
    no place in a file the tests leave behind.
    """
    return {
        name: value if name.startswith(("GIT_", "GH_CONFIG_DIR")) else ""
        for name, value in os.environ.items()
    }


def result(step, n):
    """The result line Claude Code prints at the end of a call."""
    failed = step["exit"] != 0 or step["subtype"] is not None
    usage = {"input_tokens": step["input_tokens"], "output_tokens": step["output_tokens"]}
    output = {
        "type": "result",
        "subtype": step["subtype"] or ("error_during_execution" if failed else "success"),
        "is_error": failed,
        "result": step["answer"],
        "session_id": f"fake-session-{n}",
        "num_turns": step["num_turns"],
        "duration_ms": step["duration_ms"],
        "duration_api_ms": step["duration_ms"],
        "total_cost_usd": step["cost_usd"],
        "usage": {**usage, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0},
        "modelUsage": {
            step["model"]: {
                "inputTokens": step["input_tokens"],
                "outputTokens": step["output_tokens"],
                "costUSD": step["cost_usd"],
            }
        },
    }
    return output


def turns(step, n):
    """The init line, then one assistant message per turn, splitting the tokens among them.

    Claude Code prints a message once for each content block, with the same id and
    usage, so the last message comes twice.
    """
    lines = [{"type": "system", "subtype": "init", "model": step["model"]}]
    count = max(step["num_turns"], 1)
    for k in range(count):
        share = {
            "input_tokens": step["input_tokens"] // count
            + (step["input_tokens"] % count if k == 0 else 0),
            "output_tokens": step["output_tokens"] // count
            + (step["output_tokens"] % count if k == 0 else 0),
            "cache_creation_input_tokens": 0,
            "cache_read_input_tokens": 0,
        }
        message = {"id": f"msg_fake_{n}_{k}", "model": step["model"], "usage": share}
        lines.append({"type": "assistant", "message": message})
    return [*lines, lines[-1]]


def on_interrupt(step, n):
    """Set what the fake does on SIGINT, as the step says."""
    if step["on_interrupt"] == "ignore":
        # A child inherits an ignored signal, so the step's sleep ignores it too.
        signal.signal(signal.SIGINT, signal.SIG_IGN)
    else:
        # Claude Code in stream-json mode ends on SIGINT with an error result line.
        def interrupted(signum, frame):
            line = {**result(step, n), "subtype": "error_during_execution", "is_error": True}
            print(json.dumps(line), flush=True)
            os._exit(1)

        signal.signal(signal.SIGINT, interrupted)


def do_work(step):
    """Write the step's files, and commit them when the step says so."""
    for path, content in step["files"].items():
        target = Path(path)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content)
    if step["commit"] and step["files"]:
        if step["add_all"]:
            subprocess.run(["git", "add", "-A"], check=True)
        else:
            subprocess.run(["git", "add", "--", *step["files"]], check=True)
        subprocess.run(["git", "commit", "-q", "-m", "Work by the fake agent"], check=True)


def main():
    world = World.from_env()
    prompt = sys.stdin.read()
    n = len(list(world.prompts_dir.glob("*.txt"))) + 1
    (world.prompts_dir / f"{n}.txt").write_text(prompt)

    script = world.agent_script()
    if n > len(script):
        sys.stderr.write(f"fake agent: no script entry for call {n}\n")
        return 2
    step = script[n - 1]
    world.record_agent_pid(os.getpid())
    world.record_agent_call(sys.argv[1:], recorded_env())

    on_interrupt(step, n)

    if step["stdout"] is None:
        for line in turns(step, n):
            print(json.dumps(line), flush=True)

    if step["sleep_seconds"]:
        # Sleep in a child process, as the real agent's tools do, so a timeout must stop both.
        child = subprocess.Popen(["sleep", str(step["sleep_seconds"])])
        world.record_agent_pid(child.pid)
        child.wait()

    if step["stdout"] is not None:
        sys.stdout.write(step["stdout"])
        return step["exit"]

    do_work(step)
    print(json.dumps(result(step, n)))
    return step["exit"]


if __name__ == "__main__":
    sys.exit(main())
