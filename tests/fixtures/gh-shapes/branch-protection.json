{
  "gh": "2.102.0",
  "command": [
    "api",
    "repos/{repo}/branches/{base}/protection"
  ],
  "keys": [
    "allow_deletions",
    "allow_deletions.enabled",
    "allow_force_pushes",
    "allow_force_pushes.enabled",
    "allow_fork_syncing",
    "allow_fork_syncing.enabled",
    "block_creations",
    "block_creations.enabled",
    "enforce_admins",
    "enforce_admins.enabled",
    "enforce_admins.url",
    "lock_branch",
    "lock_branch.enabled",
    "required_conversation_resolution",
    "required_conversation_resolution.enabled",
    "required_linear_history",
    "required_linear_history.enabled",
    "required_pull_request_reviews",
    "required_pull_request_reviews.dismiss_stale_reviews",
    "required_pull_request_reviews.require_code_owner_reviews",
    "required_pull_request_reviews.require_last_push_approval",
    "required_pull_request_reviews.required_approving_review_count",
    "required_pull_request_reviews.url",
    "required_signatures",
    "required_signatures.enabled",
    "required_signatures.url",
    "required_status_checks",
    "required_status_checks.checks",
    "required_status_checks.checks[].app_id",
    "required_status_checks.checks[].context",
    "required_status_checks.contexts",
    "required_status_checks.contexts_url",
    "required_status_checks.strict",
    "required_status_checks.url",
    "url"
  ]
}
