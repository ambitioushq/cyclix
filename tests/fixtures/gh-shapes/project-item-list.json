{
  "gh": "2.102.0",
  "command": [
    "project",
    "item-list",
    "{project}",
    "--owner",
    "{owner}",
    "--format",
    "json",
    "--limit",
    "100"
  ],
  "keys": [
    "items",
    "items[].content",
    "items[].content.body",
    "items[].content.number",
    "items[].content.repository",
    "items[].content.title",
    "items[].content.type",
    "items[].content.url",
    "items[].id",
    "items[].labels",
    "items[].repository",
    "items[].status",
    "items[].title",
    "totalCount"
  ]
}
