{
  "gh": "2.102.0",
  "command": [
    "api",
    "graphql",
    "-f",
    "query={items_query}",
    "-f",
    "owner={owner}",
    "-F",
    "number={project}",
    "-f",
    "field={field}"
  ],
  "keys": [
    "data",
    "data.repositoryOwner",
    "data.repositoryOwner.projectV2",
    "data.repositoryOwner.projectV2.items",
    "data.repositoryOwner.projectV2.items.nodes",
    "data.repositoryOwner.projectV2.items.nodes[].content",
    "data.repositoryOwner.projectV2.items.nodes[].content.__typename",
    "data.repositoryOwner.projectV2.items.nodes[].content.number",
    "data.repositoryOwner.projectV2.items.nodes[].content.repository",
    "data.repositoryOwner.projectV2.items.nodes[].content.repository.nameWithOwner",
    "data.repositoryOwner.projectV2.items.nodes[].content.state",
    "data.repositoryOwner.projectV2.items.nodes[].content.title",
    "data.repositoryOwner.projectV2.items.nodes[].fieldValueByName",
    "data.repositoryOwner.projectV2.items.nodes[].fieldValueByName.name",
    "data.repositoryOwner.projectV2.items.nodes[].id",
    "data.repositoryOwner.projectV2.items.pageInfo",
    "data.repositoryOwner.projectV2.items.pageInfo.endCursor",
    "data.repositoryOwner.projectV2.items.pageInfo.hasNextPage"
  ]
}
